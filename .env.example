# Copia questo file, chiama la copia ".env" e metti i tuoi valori al posto dei puntini.
# Il file .env resta solo sul tuo computer: è elencato in .gitignore e non finisce su GitHub.

# La chiave di Gemini, per il pulsante "Sistema il testo".
GEMINI_API_KEY=...

# La password per aprire la pagina: almeno 8 caratteri. Senza, la pagina resta chiusa.
PASSWORD_PAGINA=...

# Facoltativo: per usare un modello diverso da quello scritto in correzione.py.
# GEMINI_MODELLO=gemini-3.5-flash-lite
